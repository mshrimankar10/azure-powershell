/filealign:512
/optimize-
/out:obj\Debug\Microsoft.Azure.PowerShell.Cmdlets.Automation.dll
/target:library
/warnaserror+
/utf8output
/deterministic+
/langversion:7.3
/warnaserror-:NU1901,NU1902,NU1903,NU1904

