/unsafe-
/checked-
/nowarn:1701,1702,1591,1701,1702
/fullpaths
/nostdlib+
/errorreport:prompt
/doc:<PATH>../../../artifacts/Debug/Az.Automation/Microsoft.Azure.PowerShell.Cmdlets.Automation.xml
