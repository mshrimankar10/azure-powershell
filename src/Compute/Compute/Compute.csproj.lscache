TargetRefPath=
TemporaryDependencyNodeTargetIdentifier=netstandard2.0

[commandLineArguments]
/noconfig
/unsafe-
/checked-
/nowarn:1701,1702,1591,1701,1702
/fullpaths
/nostdlib+
/errorreport:prompt
/doc:<PATH>../../../artifacts/Debug/Az.Compute/Microsoft.Azure.PowerShell.Cmdlets.Compute.xml
